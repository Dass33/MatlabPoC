# Base image holds a MATLAB Runtime trimmed to just the products the compiled
# artifacts declare (see matlab/Compiled/PythonPackage/buildresult.json): ~2.9GB
# instead of the ~7.2GB in containers.mathworks.com/matlab-runtime:r2025b.
#
# It is generated by `python scripts/compile_matlab.py`, which calls
# compiler.runtime.createDockerImage. Regenerate it whenever mcc output starts
# depending on a new toolbox, otherwise the runtime will be missing products at
# load time.
ARG MCR_IMAGE=nsm-mcr:latest
FROM ${MCR_IMAGE}

# The generated base exports a global LD_LIBRARY_PATH pointing at the runtime's
# lib dirs. That must not reach the Streamlit server process -- pulling MATLAB's
# libstdc++ and TBB into it is what segfaulted pyarrow and wedged the server
# (2026-07-12 incident). mcr_worker.py and run_AnalyzeExperimentApp.sh each set
# the variable for themselves, so clear the inherited one here.
ENV LD_LIBRARY_PATH=""

RUN apt-get update && apt-get install --no-install-recommends -y \
      python3 python3-pip curl \
 && apt-get clean && apt-get -y autoremove && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layers are ordered by change frequency (rarest first) so routine edits to
# env vars, requirements, or app code never invalidate the multi-GB MATLAB
# layers: a cache bust here means re-pushing the runtime to every registry.

# Kept outside /app so a dev bind-mount of ./streamlit:/app doesn't shadow it.
COPY matlab/Compiled/PythonPackage/nsm_algorithms/ /opt/matlab_python/nsm_algorithms/

# Dark-signal calibration files. Paths to these are written into job configs and
# opened by MATLAB, so they live outside /app for the same bind-mount reason.
COPY streamlit/calibration/ /opt/calibration/
ENV CALIBRATION_DIR=/opt/calibration

RUN mkdir -p /opt/matlab_app
COPY matlab/Compiled/AnalyzeExperimentApp /opt/matlab_app/
COPY matlab/Compiled/run_AnalyzeExperimentApp.sh /opt/matlab_app/
RUN chmod +x /opt/matlab_app/run_AnalyzeExperimentApp.sh /opt/matlab_app/AnalyzeExperimentApp

COPY streamlit/requirements.txt .
RUN pip3 install --break-system-packages --no-cache-dir -r requirements.txt \
 && find /usr/local/lib/python3.12/dist-packages -name '__pycache__' -type d -prune -exec rm -rf {} +

ENV AGREE_TO_MATLAB_RUNTIME_LICENSE=yes
ENV PYTHONPATH=/opt/matlab_python

ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_ENABLE_STATIC_SERVING=true
ENV STREAMLIT_SERVER_HEADLESS=true

COPY streamlit/ .

EXPOSE 8501

CMD ["python3", "-m", "streamlit", "run", "main.py"]
