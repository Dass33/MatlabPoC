{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit-container",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "streamlit", "--build"],
      "port": 8501
    },
    {
      "name": "streamlit-local",
      "runtimeExecutable": "streamlit/venv/bin/streamlit",
      "runtimeArgs": ["run", "streamlit/main.py", "--server.port", "8502", "--server.headless", "true"],
      "port": 8502
    },
    {
      "name": "docs",
      "runtimeExecutable": "streamlit/venv/bin/mkdocs",
      "runtimeArgs": ["serve", "--dev-addr", "127.0.0.1:8000"],
      "port": 8000
    }
  ]
}
